# IE Live LLM provider configuration
# Copy to .env and export, or `set -a; source .env; set +a`

# Provider: mock | openai | local | gemini | openai_compatible
IE_LLM_PROVIDER=mock

# Model id for the selected provider
IE_LLM_MODEL=gpt-4o-mini

# Generic fallback key (optional)
# IE_LLM_API_KEY=

# --- OpenAI ---
# IE_LLM_PROVIDER=openai
# IE_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local OpenAI-compatible (Ollama / vLLM / LM Studio) ---
# IE_LLM_PROVIDER=local
# IE_LLM_MODEL=llama3.1
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# # or: LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1

# --- Google Gemini ---
# IE_LLM_PROVIDER=gemini
# IE_LLM_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=your_gemini_key
# # optional aliases: GOOGLE_API_KEY, IE_LLM_API_KEY
# # GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
